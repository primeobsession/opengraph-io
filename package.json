{
  "name": "opengraph-io",
  "version": "3.0.2",
  "description": "Website scraper to grab OpenGraph tags or supplement them when they don't exist",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "npx babel src --watch --out-dir dist",
    "build": "npx babel src --out-dir dist",
    "prepublishOnly": "npm run build",
    "cover": "jest --coverage",
    "test": "jest"
  },
  "keywords": [
    "opengraph",
    "scrape",
    "parse html"
  ],
  "homepage": "https://opengraph.io",
  "repository": "https://github.com/primeobsession/opengraph-io",
  "author": "Justin Furniss",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.9",
    "@babel/core": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "babel-jest": "^29.6.1",
    "jest": "^29.6.1"
  }
}
